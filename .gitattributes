# Store text with LF so container scripts and EDA inputs behave identically on every host.
* text=auto eol=lf

*.py         text eol=lf
*.ps1        text eol=lf
*.sh         text eol=lf
*.sv         text eol=lf
*.v          text eol=lf
*.svh        text eol=lf
*.vh         text eol=lf
*.ys         text eol=lf
*.tcl        text eol=lf
*.sdc        text eol=lf
*.sby        text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.tex        text eol=lf
*.txt        text eol=lf
*.html       text eol=lf
Dockerfile   text eol=lf
*.mk         text eol=lf

# Binary artifacts are never normalized.
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.pdf        binary
*.gds        binary
*.gds.gz     binary
