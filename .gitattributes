# SiliconBench is developed on a Windows host but all tools run inside a linux/amd64 container.
# Force LF everywhere so shell scripts, Tcl, .ys, .sby, and RTL never reach the container as CRLF
# (CRLF breaks bash: "bash: \r: command not found", and can trip SDC/Tcl parsers).
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.sv        text eol=lf
*.v         text eol=lf
*.svh       text eol=lf
*.vh        text eol=lf
*.ys        text eol=lf
*.tcl       text eol=lf
*.sdc       text eol=lf
*.sby       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
Dockerfile  text eol=lf
*.mk        text eol=lf

# Binary assets - never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.gds  binary
*.gds.gz binary

